// 时间与"夜归属"工具。
// 夜归属规则（全 app 唯一）：凌晨 00:00–06:59 的记录归属于前一天晚上，
// 即一"晚"的体感窗口为 前日 20:00 → 次日 07:00。

export function pad2(n: number): string {
  return n < 10 ? '0' + n.toString() : n.toString()
}

export function fmtHM(ts: number): string {
  const d = new Date(ts)
  return pad2(d.getHours()) + ':' + pad2(d.getMinutes())
}

export function fmtMD(ts: number): string {
  const d = new Date(ts)
  return (d.getMonth() + 1).toString() + '月' + d.getDate().toString() + '日'
}

const WEEKDAYS = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']

export function weekdayCn(ts: number): string {
  return WEEKDAYS[new Date(ts).getDay()]
}

// 夜归属：凌晨 0–6 点归前一天，返回 yyyy-MM-dd
export function nightDate(ts: number): string {
  const d = new Date(ts)
  if (d.getHours() < 7) {
    d.setDate(d.getDate() - 1)
  }
  return d.getFullYear().toString() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate())
}

// 当前时刻是否处于夜间窗口（00:00–06:59 或 20:00–23:59）
export function isNightTime(ts: number): boolean {
  const h = new Date(ts).getHours()
  return h < 7 || h >= 20
}

// 历史页"今晚/昨晚"胶囊展示的一夜：夜间=进行中的一夜，白天=刚结束的昨晚
export function latestNightKey(ts: number): string {
  if (isNightTime(ts)) {
    return nightDate(ts)
  }
  return nightDate(ts - 8 * 3600 * 1000)
}

// "昨晚"（最近一个已结束的夜）：任何时刻向前推 24h 再取夜归属，
// 夜间=进行中那夜的前一夜，白天=刚结束的那夜
export function lastCompletedNightKey(ts: number): string {
  return nightDate(ts - 24 * 3600 * 1000)
}

// 某一夜的入睡时刻（night 当天 20:00），night 格式 yyyy-MM-dd
export function nightStartTs(night: string): number {
  const p = night.split('-').map((s: string): number => parseInt(s))
  return new Date(p[0], p[1] - 1, p[2], 20, 0, 0, 0).getTime()
}

// 夜窗口文案：10月23日 20:00 → 10月24日 07:00
export function nightWindowText(night: string): string {
  const start = nightStartTs(night)
  const end = start + 11 * 3600 * 1000
  return fmtMD(start) + ' 20:00 → ' + fmtMD(end) + ' 07:00'
}

// 距上次的间隔文案：1h25m / 45m
export function gapText(ms: number): string {
  const m = Math.round(ms / 60000)
  const h = Math.floor(m / 60)
  if (h > 0) {
    return h.toString() + 'h' + (m % 60).toString() + 'm'
  }
  return m.toString() + 'm'
}
