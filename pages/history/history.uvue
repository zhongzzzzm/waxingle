  background-color: #ffc84a;
}
.chip-text-hl {
  font-size: 22rpx;
  color: #3f2d04;
  font-weight: bold;
}
.section {
  padding: 0 30rpx;
}
.month-seg {
  padding: 30rpx 6rpx 14rpx;
}
.month-text {
  font-size: 22rpx;
  color: #9094bd;
  font-weight: bold;
}
.card {
  background-color: #181b36;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}
.card-head {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
}
.card-head-press {
  background-color: #22264c;
}
.card-date {
  font-size: 30rpx;
  font-weight: bold;
  color: #f0f1fb;
}
.card-cnt {
  flex-direction: row;
  align-items: center;
}
.card-cnt-text {
  font-size: 26rpx;
  color: #ffc84a;
  font-weight: bold;
}
.card-arrow {
  font-size: 24rpx;
  color: #9094bd;
  margin-left: 10rpx;
}
.card-body {
  padding: 0 18rpx 18rpx;
}
.card-window {
  font-size: 20rpx;
  color: #9094bd;
  margin: 6rpx 12rpx 14rpx;
}
.wake-item {
  flex-direction: row;
  align-items: center;
  background-color: #22264c;
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 12rpx;
}
.wake-time {
  font-size: 30rpx;
  font-weight: bold;
  color: #f0f1fb;
}
.wake-gap {
  flex: 1;
  text-align: right;
  font-size: 22rpx;
  color: #9094bd;
  margin-right: 16rpx;
}
.wake-del {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  align-items: center;
  justify-content: center;
}
.wake-del-press {
  background-color: #3a3f7a;
}
.wake-del-text {
  font-size: 34rpx;
  color: #9094bd;
}
.empty {
  align-items: center;
  padding: 120rpx 0;
}
.empty-main {
  font-size: 30rpx;
  color: #9094bd;
}
.empty-sub {
  font-size: 24rpx;
  color: #6a6e96;
  margin-top: 14rpx;
}
</style>
