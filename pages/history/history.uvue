<template>
  <view class="page">
    <scroll-view class="body" :scroll-y="true">
      <view class="hist-top">
        <view class="gear" hover-class="gear-press" @click="openSettings">
          <text class="gear-text">⚙</text>
        </view>
      </view>
      <view class="chips">
        <view class="chip chip-hl">
          <text class="chip-text-hl">{{ lastNightText }}</text>
        </view>
        <view class="chip">
          <text class="chip-text">{{ weekText }}</text>
        </view>
      </view>
      <view v-if="nights.length == 0" class="empty">
        <text class="empty-main">还没有记录</text>
        <text class="empty-sub">晚上去「记录」点「睡着了」开始</text>
      </view>
      <view v-for="sec in sections" :key="sec.label" class="section">
        <view class="month-seg">
          <text class="month-text">{{ sec.label }}</text>
        </view>
        <view v-for="n in sec.nights" :key="n.night" class="card">
          <view class="card-head" hover-class="card-head-press" @click="toggle(n.night)">
            <view class="card-head-left">
              <text class="card-date">{{ n.dateLabel }}</text>
              <text class="card-sub">{{ n.headSub }}</text>
            </view>
            <view class="card-cnt">
              <text class="card-cnt-text">{{ n.count > 0 ? '醒了 ' + n.count + ' 次' : '一觉到天亮' }}</text>
              <text class="card-arrow">{{ isExpanded(n.night) ? '▴' : '▾' }}</text>
            </view>
          </view>
          <view v-if="isExpanded(n.night)" class="card-body">
            <view v-if="n.hasTimeline" class="tl">
              <view class="tl-track">
                <view class="tl-fill" :style="'left:' + n.fillLeft + ';width:' + n.fillWidth"></view>
                <view v-for="d in n.dots" :key="d" class="tl-dot" :style="'left:' + d"></view>
              </view>
              <view class="tl-scale">
                <text class="tl-scale-text">{{ n.tlStartLabel }}</text>
                <text class="tl-scale-text">{{ n.tlEndLabel }}</text>
              </view>
            </view>
            <view v-for="e in n.events" :key="'e' + e.ts.toString()" class="wake-item">
              <text class="wake-time">{{ e.time }}</text>
              <text class="wake-label">{{ e.label }}</text>
              <text class="wake-gap">{{ e.dur }}</text>
              <view v-if="e.delId.length > 0" class="wake-del" hover-class="wake-del-press" @click="confirmDelete(e.delId, e.ts, n.night)">
                <text class="wake-del-text">×</text>
              </view>
            </view>
            <text v-if="n.bestText.length > 0" class="best-line">{{ n.bestText }}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { loadAllSessions, deleteWake } from '@/common/store.uts'
import { SleepSession } from '@/common/store.uts'
import { fmtHM, fmtMD, weekdayCn, gapText, nightDate, nightStartTs, lastCompletedNightKey } from '@/common/time.uts'

type DisplayEvent = {
  delId: string,      // 可删除的醒点 id；入睡/起床行为空
  ts: number,
  time: string,
  label: string,      // 入睡 / 醒了 / 起床
  dur: string         // 这一觉 XhYm（首尾不全时为空）
}

type DisplayNight = {
  night: string,
  dateLabel: string,
  headSub: string,
  count: number,
  hasTimeline: boolean,
  fillLeft: string,
  fillWidth: string,
  dots: Array<string>,
  tlStartLabel: string,
  tlEndLabel: string,
  events: Array<DisplayEvent>,
  bestText: string
}

type DisplaySection = {
  label: string,
  nights: Array<DisplayNight>
}

const nowTs = ref<number>(Date.now())
const sessions = ref<Array<SleepSession>>([])
const expanded = ref<Array<string>>([])

function isExpanded(night: string): boolean {
  return expanded.value.indexOf(night) >= 0
}

function toggle(night: string) {
  const idx = expanded.value.indexOf(night)
  if (idx >= 0) {
    expanded.value.splice(idx, 1)
  } else {
    expanded.value.push(night)
  }
}

function openSettings() {
  uni.navigateTo({ url: '/pages/settings/settings' })
}

// 一段连续睡眠（相邻事件之间的间隔）
type SleepSeg = {
  durMs: number,
  label: string
}

function pct(v: number, span: number): string {
  let p = v * 100 / span
  if (p < 0) {
    p = 0
  }
  if (p > 100) {
    p = 100
  }
  return p.toFixed(1) + '%'
}

function buildNight(s: SleepSession): DisplayNight {
  const startTs = nightStartTs(s.night)
  const wakes = s.wakes
  // 明细事件
  const events: Array<DisplayEvent> = []
  const segs: Array<SleepSeg> = []
  if (s.bedtime > 0) {
    events.push({ delId: '', ts: s.bedtime, time: fmtHM(s.bedtime), label: '入睡', dur: '' })
  }
  for (let i = 0; i < wakes.length; i++) {
    const prev = i == 0 ? s.bedtime : wakes[i - 1].ts
    let dur = ''
    if (prev > 0) {
      dur = '这一觉 ' + gapText(wakes[i].ts - prev)
      const segLabel = i == 0 ? '入睡到第一次醒' : '第' + i.toString() + '次醒后'
      segs.push({ durMs: wakes[i].ts - prev, label: segLabel })
    }
    events.push({ delId: wakes[i].id, ts: wakes[i].ts, time: fmtHM(wakes[i].ts), label: '醒了', dur: dur })
  }
  if (s.wakeUp > 0) {
    let prev = 0
    if (wakes.length > 0) {
      prev = wakes[wakes.length - 1].ts
    } else {
      prev = s.bedtime
    }
    let dur = ''
    if (prev > 0) {
      if (wakes.length == 0 && s.bedtime > 0) {
        dur = '一觉到天亮'
        segs.push({ durMs: s.wakeUp - prev, label: '一觉到天亮' })
      } else {
        dur = '这一觉 ' + gapText(s.wakeUp - prev)
        segs.push({ durMs: s.wakeUp - prev, label: '末次醒到起床' })
      }
    }
    events.push({ delId: '', ts: s.wakeUp, time: fmtHM(s.wakeUp), label: '起床', dur: dur })
  }
  // 最长一觉
  let bestText = ''
  let best: SleepSeg | null = null
  for (let i = 0; i < segs.length; i++) {
    if (best == null || segs[i].durMs > best.durMs) {
      best = segs[i]
    }
  }
  if (best != null) {
    bestText = '最长一觉 ' + gapText(best.durMs) + ' · ' + best.label
  }
  // 卡片副行
  let headSub = ''
  if (s.bedtime > 0 && s.wakeUp > 0) {
    headSub = fmtHM(s.bedtime) + ' → ' + fmtHM(s.wakeUp) + ' · 整夜 ' + gapText(s.wakeUp - s.bedtime)
  } else if (s.bedtime > 0 && s.wakeUp == 0) {
    headSub = '入睡 ' + fmtHM(s.bedtime) + ' · 未记起床'
  } else if (s.bedtime == 0 && s.wakeUp > 0) {
    headSub = '未记入睡 · 起床 ' + fmtHM(s.wakeUp)
  } else {
    headSub = '旧版数据 · 未记入睡/起床'
  }
  // 夜间时间轴（有入睡才画）：20:00 → max(起床, 次日 07:00)，蓝条=睡，黄点=醒
  const hasTimeline = s.bedtime > 0
  const dots: Array<string> = []
  let fillLeft = '0%'
  let fillWidth = '0%'
  let tlStartLabel = ''
  let tlEndLabel = ''
  if (hasTimeline) {
    let endTs = startTs + 11 * 3600 * 1000
    if (s.wakeUp > endTs) {
      endTs = s.wakeUp
    }
    if (s.wakeUp == 0 && nowTs.value > endTs) {
      endTs = nowTs.value
    }
    const span = endTs - startTs
    fillLeft = pct(s.bedtime - startTs, span)
    fillWidth = pct((s.wakeUp > 0 ? s.wakeUp : nowTs.value) - s.bedtime, span)
    for (let i = 0; i < wakes.length; i++) {
      dots.push(pct(wakes[i].ts - startTs, span))
    }
    tlStartLabel = fmtHM(startTs)
    tlEndLabel = fmtHM(endTs)
  }
  const dn: DisplayNight = {
    night: s.night,
    dateLabel: fmtMD(startTs) + ' · ' + weekdayCn(startTs),
    headSub: headSub,
    count: wakes.length,
    hasTimeline: hasTimeline,
    fillLeft: fillLeft,
    fillWidth: fillWidth,
    dots: dots,
    tlStartLabel: tlStartLabel,
    tlEndLabel: tlEndLabel,
    events: events,
    bestText: bestText
  }
  return dn
}

const nights = computed((): Array<DisplayNight> => {
  const out: Array<DisplayNight> = []
  for (let i = 0; i < sessions.value.length; i++) {
    out.push(buildNight(sessions.value[i]))
  }
  return out
})

const sections = computed((): Array<DisplaySection> => {
  const ns = nights.value
  const out: Array<DisplaySection> = []
  for (let i = 0; i < ns.length; i++) {
    const n = ns[i]
    const p = n.night.split('-').map((s: string): number => parseInt(s))
    const label = p[0].toString() + ' 年 ' + p[1].toString() + ' 月'
    let target: DisplaySection | null = null
    for (let j = 0; j < out.length; j++) {
      if (out[j].label == label) {
        target = out[j]
        break
      }
    }
    if (target == null) {
      const list: Array<DisplayNight> = []
      list.push(n)
      const sec: DisplaySection = { label: label, nights: list }
      out.push(sec)
    } else {
      target.nights.push(n)
    }
  }
  return out
})

function findSession(night: string): SleepSession | null {
  for (let i = 0; i < sessions.value.length; i++) {
    if (sessions.value[i].night == night) {
      return sessions.value[i]
    }
  }
  return null
}

// 首位高亮胶囊：最近一个已结束的夜
const lastNightText = computed((): string => {
  const t = findSession(lastCompletedNightKey(nowTs.value))
  if (t == null) {
    return '昨晚无记录'
  }
  let text = '昨晚醒 ' + t.wakes.length.toString() + ' 次'
  if (t.bedtime > 0 && t.wakeUp > 0) {
    text = text + ' · 整夜 ' + gapText(t.wakeUp - t.bedtime)
  }
  return text
})

// 近 7 天合计：最近 7 个已结束夜的醒点总数（含 0 次的夜）
const weekText = computed((): string => {
  const endKey = lastCompletedNightKey(nowTs.value)
  const startKey = nightDate(nowTs.value - 7 * 24 * 3600 * 1000)
  let count = 0
  for (let i = 0; i < sessions.value.length; i++) {
    const s = sessions.value[i]
    if (s.night >= startKey && s.night <= endKey) {
      count += s.wakes.length
    }
  }
  return '近 7 天合计 ' + count.toString() + ' 次'
})

onShow(() => {
  sessions.value = loadAllSessions()
  nowTs.value = Date.now()
  if (expanded.value.length == 0 && sessions.value.length > 0) {
    expanded.value.push(sessions.value[0].night)
  }
})

function confirmDelete(id: string, ts: number, night: string) {
  uni.showModal({
    title: '删除记录',
    content: '删除 ' + fmtHM(ts) + ' 这条记录？',
    confirmText: '删除',
    success: (res) => {
      if (res.confirm) {
        deleteWake(night, id)
        sessions.value = loadAllSessions()
      }
    }
  })
}
</script>

<style>
.page {
  flex: 1;
  background-color: #101226;
}
.body {
  flex: 1;
}
.hist-top {
  flex-direction: row;
  justify-content: flex-end;
  padding: 12rpx 24rpx 0;
}
.gear {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  align-items: center;
  justify-content: center;
}
.gear-press {
  background-color: #22264c;
}
.gear-text {
  font-size: 40rpx;
  color: #9094bd;
}
.chips {
  flex-direction: row;
  flex-wrap: wrap;
  padding: 16rpx 30rpx 6rpx;
}
.chip {
  background-color: #22264c;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  margin-right: 16rpx;
  margin-bottom: 10rpx;
}
.chip-text {
  font-size: 26rpx;
  color: #f0f1fb;
}
.chip-hl {
  background-color: #ffc84a;
}
.chip-text-hl {
  font-size: 26rpx;
  color: #3f2d04;
  font-weight: bold;
}
.section {
  padding: 0 30rpx;
}
.month-seg {
  padding: 32rpx 6rpx 14rpx;
}
.month-text {
  font-size: 24rpx;
  color: #9094bd;
  font-weight: bold;
}
.card {
  background-color: #181b36;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}
.card-head {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 32rpx;
}
.card-head-press {
  background-color: #22264c;
}
.card-head-left {
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  margin-right: 20rpx;
}
.card-date {
  font-size: 32rpx;
  font-weight: bold;
  color: #f0f1fb;
}
.card-sub {
  font-size: 24rpx;
  color: #9094bd;
  margin-top: 8rpx;
}
.card-cnt {
  flex-direction: row;
  align-items: center;
}
.card-cnt-text {
  font-size: 28rpx;
  color: #ffc84a;
  font-weight: bold;
}
.card-arrow {
  font-size: 26rpx;
  color: #9094bd;
  margin-left: 10rpx;
}
.card-body {
  padding: 0 18rpx 18rpx;
}
.tl {
  padding: 8rpx 12rpx 4rpx;
}
.tl-track {
  position: relative;
  height: 20rpx;
  border-radius: 10rpx;
  background-color: #2a2e55;
}
.tl-fill {
  position: absolute;
  top: 0;
  height: 20rpx;
  border-radius: 10rpx;
  background-color: #4c5cc0;
}
.tl-dot {
  position: absolute;
  top: -2rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background-color: #ffc84a;
}
.tl-scale {
  flex-direction: row;
  justify-content: space-between;
  margin-top: 12rpx;
}
.tl-scale-text {
  font-size: 24rpx;
  color: #6a6e96;
}
.wake-item {
  flex-direction: row;
  align-items: center;
  background-color: #22264c;
  border-radius: 18rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 12rpx;
}
.wake-time {
  font-size: 32rpx;
  font-weight: bold;
  color: #f0f1fb;
}
.wake-label {
  font-size: 28rpx;
  color: #c6c9e6;
  flex: 1;
  margin-left: 16rpx;
}
.wake-gap {
  font-size: 26rpx;
  color: #9094bd;
  margin-right: 16rpx;
}
.wake-del {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  align-items: center;
  justify-content: center;
}
.wake-del-press {
  background-color: #3a3f7a;
}
.wake-del-text {
  font-size: 36rpx;
  color: #9094bd;
}
.best-line {
  font-size: 26rpx;
  color: #ffc84a;
  margin: 6rpx 24rpx 12rpx;
}
.empty {
  align-items: center;
  padding: 120rpx 0;
}
.empty-main {
  font-size: 32rpx;
  color: #9094bd;
}
.empty-sub {
  font-size: 28rpx;
  color: #6a6e96;
  margin-top: 14rpx;
}
</style>
