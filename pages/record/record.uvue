.page {
  flex: 1;
  background-color: #101226;
}
.center {
  flex: 1;
  justify-content: center;
  align-items: center;
  padding: 0 40rpx 60rpx;
}
.stat {
  align-items: center;
  margin-bottom: 70rpx;
}
.stat-label {
  font-size: 32rpx;
  color: #9094bd;
}
.stat-row {
  flex-direction: row;
  align-items: flex-end;
  margin-top: 10rpx;
}
.stat-num {
  font-size: 150rpx;
  font-weight: bold;
  color: #f0f1fb;
  line-height: 150rpx;
}
.stat-unit {
  font-size: 32rpx;
  color: #9094bd;
  margin-left: 12rpx;
  margin-bottom: 24rpx;
}
.stat-sub {
  font-size: 26rpx;
  color: #9094bd;
  margin-top: 12rpx;
}
.big-btn {
  width: 400rpx;
  height: 400rpx;
  border-radius: 200rpx;
  align-items: center;
  justify-content: center;
  background-image: linear-gradient(180deg, #ffdd82, #f0a81c);
}
.big-btn-press {
  transform: scale(0.93);
  background-image: linear-gradient(180deg, #f0a81c, #e29a10);
}
.big-btn-main {
  font-size: 80rpx;
  font-weight: bold;
  color: #3f2d04;
}
.big-btn-sub {
  font-size: 26rpx;
  color: #6b4d0a;
  margin-top: 10rpx;
}
.undo-bar {
  flex-direction: row;
  align-items: center;
  background-color: #22264c;
  border-radius: 999rpx;
  padding: 12rpx 14rpx 12rpx 32rpx;
  margin-top: 48rpx;
}
.undo-text {
  font-size: 28rpx;
  color: #f0f1fb;
  margin-right: 24rpx;
}
.undo-btn {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background-color: #2d3161;
}
.undo-btn-press {
  background-color: #3a3f7a;
}
.undo-btn-text {
  font-size: 28rpx;
  color: #ffc84a;
  font-weight: bold;
}
.last-line {
  font-size: 26rpx;
  color: #9094bd;
  margin-top: 48rpx;
}
</style>
