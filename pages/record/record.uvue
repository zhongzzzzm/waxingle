  width: 400rpx;
  height: 400rpx;
  border-radius: 200rpx;
  align-items: center;
  justify-content: center;
  background-image: linear-gradient(180deg, #ffdd82, #f0a81c);
}
.big-btn-press {
  transform: scale(0.93);
  background-image: linear-gradient(180deg, #f0a81c, #e29a10);
}
.big-btn-main {
  font-size: 68rpx;
  font-weight: bold;
  color: #3f2d04;
}
.big-btn-sub {
  font-size: 22rpx;
  color: #6b4d0a;
  margin-top: 8rpx;
}
.undo-bar {
  flex-direction: row;
  align-items: center;
  background-color: #22264c;
  border-radius: 999rpx;
  padding: 10rpx 12rpx 10rpx 30rpx;
  margin-top: 44rpx;
}
.undo-text {
  font-size: 26rpx;
  color: #f0f1fb;
  margin-right: 20rpx;
}
.undo-btn {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background-color: #2d3161;
}
.undo-btn-press {
  background-color: #3a3f7a;
}
.undo-btn-text {
  font-size: 26rpx;
  color: #ffc84a;
  font-weight: bold;
}
.last-line {
  font-size: 24rpx;
  color: #9094bd;
  margin-top: 44rpx;
}
.rec-head {
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  padding: 20rpx 30rpx 0;
}
.gear {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}
.gear-press {
  background-color: #22264c;
}
.gear-text {
  font-size: 34rpx;
  color: #9094bd;
}
.mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  justify-content: flex-end;
}
.sheet {
  background-color: #181b36;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 36rpx 36rpx 60rpx;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #f0f1fb;
  margin-bottom: 30rpx;
}
.sheet-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.sheet-texts {
  flex: 1;
