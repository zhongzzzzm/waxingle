<template>
  <view class="page">
    <view class="rec-head">
      <text class="rec-date">{{ dateLine }}</text>
      <view class="gear" hover-class="gear-press" @click="openPanel">
        <text class="gear-text">⚙</text>
      </view>
    </view>
    <view class="center">
      <view class="stat">
        <text class="stat-label">今晚已醒</text>
        <view class="stat-row">
          <text class="stat-num">{{ tonightCount }}</text>
          <text class="stat-unit">次</text>
        </view>
        <text class="stat-sub">{{ statSub }}</text>
      </view>
      <view class="big-btn" hover-class="big-btn-press" @click="onAdd">
        <text class="big-btn-main">醒了</text>
        <text class="big-btn-sub">点一下 · 记一次</text>
      </view>
      <view v-if="undoVisible" class="undo-bar">
        <text class="undo-text">{{ undoText }}</text>
        <view class="undo-btn" hover-class="undo-btn-press" @click="onUndo">
          <text class="undo-btn-text">撤销</text>
        </view>
      </view>
      <text v-else-if="lastText.length > 0" class="last-line">{{ lastText }}</text>
    </view>
    <view v-if="panelVisible" class="mask" @click="closePanel">
      <view class="sheet" @click.stop="noop">
        <text class="sheet-title">每晨报告</text>
        <view class="sheet-row">
          <view class="sheet-texts">
            <text class="sheet-name">每天早上 9 点通知昨晚次数</text>
            <text class="sheet-desc">昨晚醒了几次，早上 9 点见分晓</text>
          </view>
          <switch :checked="notifyOn" color="#ffc84a" @change="onNotifySwitch" />
        </view>
        <text class="sheet-note">从最近任务里强杀 App 后通知会暂停，下次打开自动恢复；如未收到通知，请检查系统通知权限。</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { loadAllRecords, addRecord, deleteRecord } from '@/common/store.uts'
import { WakeRecord } from '@/common/store.uts'
import { fmtHM, fmtMD, weekdayCn, sceneWord, nightDate, isNightTime, nightWindowText, latestNightKey } from '@/common/time.uts'

// #ifdef APP-ANDROID
import { enable, disable, isEnabled, setSummary, requestPermission } from '@/uni_modules/wa-notify'
// #endif

const nowTs = ref<number>(Date.now())
const records = ref<Array<WakeRecord>>([])

// 记录页永远显示"今天这一夜"（凌晨 0–7 点因夜归属规则自动指向昨晚开始的那夜）
const todayNight = computed((): string => {
  return nightDate(nowTs.value)
})

const dateLine = computed((): string => {
  return fmtMD(nowTs.value) + ' · ' + weekdayCn(nowTs.value) + ' · ' + sceneWord(nowTs.value)
})

const statSub = computed((): string => {
  return nightWindowText(todayNight.value) + (isNightTime(nowTs.value) ? ' · 进行中' : ' · 20:00 开始')
})

const tonightCount = computed((): number => {
  const key = todayNight.value
  let count = 0
  for (let i = 0; i < records.value.length; i++) {
    if (nightDate(records.value[i].ts) == key) {
      count++
    }
  }
  return count
})

const lastText = computed((): string => {
  if (records.value.length == 0) {
    return ''
  }
  return '上次记录 ' + fmtHM(records.value[records.value.length - 1].ts)
})

let lastClick = 0
let undoId = ''
let undoTs = 0
let undoTimer = -1
const undoVisible = ref<boolean>(false)
const undoText = ref<string>('')

const panelVisible = ref<boolean>(false)
const notifyOn = ref<boolean>(false)

function openPanel() {
  panelVisible.value = true
}

function closePanel() {
  panelVisible.value = false
}

function noop() {}

// 上报摘要：最近一夜（key + 次数）写入通知插件，供次日 09:00 接收器读取
// #ifdef APP-ANDROID
function updateNotifySummary() {
  const key = latestNightKey(nowTs.value)
  let count = 0
  for (let i = 0; i < records.value.length; i++) {
    if (nightDate(records.value[i].ts) == key) {
      count++
    }
  }
  setSummary(key, count)
}

function onNotifySwitch(e: SwitchChangeEvent) {
  if (e.detail.value) {
    requestPermission()
    enable()
    notifyOn.value = true
  } else {
    disable()
    notifyOn.value = false
  }
}
// #endif

onShow(() => {
  records.value = loadAllRecords()
  nowTs.value = Date.now()
  // #ifdef APP-ANDROID
  notifyOn.value = isEnabled()
  updateNotifySummary()
  // #endif
})

function removeLocal(id: string) {
  const idx = records.value.findIndex((r: WakeRecord): boolean => r.id == id)
  if (idx >= 0) {
    records.value.splice(idx, 1)
  }
}

function clearUndo() {
  undoId = ''
  undoTs = 0
  undoVisible.value = false
  if (undoTimer != -1) {
    clearTimeout(undoTimer)
    undoTimer = -1
  }
}

function onAdd() {
  const now = Date.now()
  if (now - lastClick < 800) {
    return
  }
  lastClick = now
  const rec = addRecord(now)
  records.value.push(rec)
  uni.vibrateShort({ type: 'light' })
  undoId = rec.id
  undoTs = rec.ts
  undoText.value = '已记录 ' + fmtHM(rec.ts)
  undoVisible.value = true
  if (undoTimer != -1) {
    clearTimeout(undoTimer)
  }
  undoTimer = setTimeout(() => {
    undoVisible.value = false
    undoTimer = -1
  }, 5000)
  // #ifdef APP-ANDROID
  updateNotifySummary()
  // #endif
}

function onUndo() {
  if (undoId.length == 0) {
    return
  }
  deleteRecord(undoId, undoTs)
  removeLocal(undoId)
  clearUndo()
  // #ifdef APP-ANDROID
  updateNotifySummary()
  // #endif
}
</script>

