  margin: 0 30rpx;
  background-color: #181b36;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}
.row {
  flex-direction: row;
  align-items: center;
  padding: 28rpx 30rpx;
}
.row-div {
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}
.row-between {
  justify-content: space-between;
}
.row-texts {
  flex: 1;
  flex-direction: column;
  margin-right: 20rpx;
}
.row-name {
  font-size: 30rpx;
  color: #f0f1fb;
}
