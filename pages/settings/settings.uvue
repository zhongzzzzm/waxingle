<template>
  <view class="page">
    <scroll-view class="body" :scroll-y="true">
      <view class="group-seg">
        <text class="group-title">通知</text>
      </view>
      <view class="group-card">
        <view class="row">
          <view class="row-texts">
            <text class="row-name">每晨报告</text>
            <text class="row-desc">每天早上 9 点通知昨晚次数与整夜时长</text>
          </view>
          <switch :checked="notifyOn" color="#ffc84a" @change="onNotifySwitch" />
        </view>
      </view>
      <view class="note-seg">
        <text class="note">从最近任务里强杀 App 后通知会暂停，下次打开自动恢复；如未收到通知，请检查系统通知权限。</text>
      </view>
      <view class="group-seg">
        <text class="group-title">关于</text>
      </view>
      <view class="group-card">
        <view class="row">
          <view class="row-texts">
            <text class="row-name">娃醒了是什么</text>
            <text class="row-desc">记宝宝几点入睡、夜里醒几次、早上几点起——半夜只点一下。</text>
          </view>
        </view>
        <view class="row row-div">
          <view class="row-texts">
            <text class="row-name">怎么算「一晚」</text>
            <text class="row-desc">一晚从点「睡着了」开始，到点「起床」结束；凌晨 0–7 点自动算前一晚。忘了点「睡着了」也没关系，直接点「醒了」会自动开夜。</text>
          </view>
        </view>
        <view class="row row-div">
          <view class="row-texts">
            <text class="row-name">数据与隐私</text>
            <text class="row-desc">所有记录只存在手机本地，无网络、无账号、不上传。</text>
          </view>
        </view>
        <view class="row row-div">
          <view class="row-texts">
            <text class="row-name">开源</text>
            <text class="row-desc">github.com/zhongzzzzm/waxingle（MIT）</text>
          </view>
        </view>
        <view class="row row-div row-between">
          <text class="row-name">版本</text>
          <text class="row-val">v2.0.0</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'

// #ifdef APP-ANDROID
import { enable, disable, isEnabled, requestPermission } from '@/uni_modules/wa-notify'
// #endif

const notifyOn = ref<boolean>(false)

onShow(() => {
  // #ifdef APP-ANDROID
  notifyOn.value = isEnabled()
  // #endif
})

// #ifdef APP-ANDROID
function onNotifySwitch(e: SwitchChangeEvent) {
  if (e.detail.value) {
    requestPermission()
    enable()
    notifyOn.value = true
  } else {
    disable()
    notifyOn.value = false
  }
}
// #endif
</script>

<style>
.page {
  flex: 1;
  background-color: #101226;
}
.body {
  flex: 1;
}
